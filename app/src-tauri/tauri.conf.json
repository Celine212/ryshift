{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shiftwheel",
  "identifier": "io.github.alexriderspy.shiftwheel",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "wheel",
        "url": "index.html",
        "title": "Shiftwheel",
        "width": 320,
        "height": 320,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visibleOnAllWorkspaces": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "nsis", "deb", "appimage"],
    "category": "Utility",
    "shortDescription": "Drag a file, hold Shift, drop it on a wheel",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../lib/*": "lib/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
